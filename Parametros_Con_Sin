def calcular_descuento(precio_original, porcentaje):
    descuento = precio_original * (porcentaje / 100)
    precio_final = precio_original - descuento
    return precio_final

total_a_pagar = calcular_descuento(500, 20)
print(f"El total con descuento es: ${total_a_pagar}")

def verificar_acceso(nombre, edad):
    if edad >= 18:
        print(f"Adelante, {nombre}. Tienes acceso libre por ser mayor de edad.")
    else:
        print(f"Lo siento, {nombre}. El acceso es solo para mayores de 18 años.")

verificar_acceso("Sofía", 22)
verificar_acceso("Mateo", 15)